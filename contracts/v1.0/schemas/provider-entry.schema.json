{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus-apex.contracts/v1.0/provider-entry.schema.json",
  "title": "ProviderModelEntry",
  "description": "NEXUS APEX Provider Registry V1 entry schema defining provider/model metadata, capabilities, modalities, lifecycle, health, privacy classification, cost, reliability, latency, timeouts, rate limits, and credential environment variable reference.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "provider_id",
    "model_id",
    "supported_capabilities",
    "supported_modalities",
    "lifecycle_status",
    "availability_status",
    "privacy_handling",
    "cost",
    "quality_score",
    "reliability_score",
    "latency",
    "timeout_ms",
    "rate_limit",
    "allowed_scopes",
    "credential_env_var"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "1.0"
    },
    "provider_id": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[a-z0-9_-]+$"
    },
    "model_id": {
      "type": "string",
      "minLength": 2,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9._:/-]+$"
    },
    "supported_capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "research",
          "screenplay",
          "storyboard",
          "image_generation",
          "video_generation",
          "audio_generation",
          "media_editing",
          "quality_inspection",
          "code_generation",
          "web_development",
          "document_generation",
          "business_workflow",
          "structured_reasoning",
          "external_publish",
          "external_message",
          "financial_transaction",
          "destructive_action"
        ]
      }
    },
    "supported_modalities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["text", "json", "code", "image", "video", "audio", "document"]
      }
    },
    "lifecycle_status": {
      "type": "string",
      "enum": ["active", "preview", "deprecated", "retired"]
    },
    "availability_status": {
      "type": "string",
      "enum": ["available", "degraded", "unavailable", "maintenance"]
    },
    "privacy_handling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "max_data_sensitivity",
        "zero_data_retention",
        "trains_on_customer_data",
        "supports_pii"
      ],
      "properties": {
        "classification": {
          "type": "string",
          "enum": ["zero_retention_isolated", "enterprise_private", "standard_commercial", "training_opted_in"]
        },
        "max_data_sensitivity": {
          "type": "string",
          "enum": ["public", "internal", "confidential", "restricted"]
        },
        "zero_data_retention": {
          "type": "boolean"
        },
        "trains_on_customer_data": {
          "type": "boolean"
        },
        "supports_pii": {
          "type": "boolean"
        },
        "regions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 2 }
        }
      }
    },
    "cost": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "estimated_cost_per_request", "currency"],
          "properties": {
            "state": { "const": "known" },
            "estimated_cost_per_request": { "type": "number", "minimum": 0 },
            "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
            "unit": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state"],
          "properties": {
            "state": { "const": "unknown" },
            "reason": { "type": "string" }
          }
        }
      ]
    },
    "quality_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "reliability_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "latency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["p50_ms", "p95_ms"],
      "properties": {
        "p50_ms": { "type": "integer", "minimum": 1 },
        "p95_ms": { "type": "integer", "minimum": 1 }
      }
    },
    "timeout_ms": {
      "type": "integer",
      "minimum": 100,
      "maximum": 3600000
    },
    "rate_limit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests_per_minute", "max_concurrent"],
      "properties": {
        "requests_per_minute": { "type": "integer", "minimum": 1 },
        "max_concurrent": { "type": "integer", "minimum": 1 },
        "tokens_per_minute": { "type": "integer", "minimum": 1 }
      }
    },
    "allowed_scopes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "model.invoke",
          "media.generate",
          "repo.read",
          "repo.write",
          "document.write",
          "external.publish",
          "external.message",
          "billing.spend",
          "account.modify",
          "system.destructive"
        ]
      }
    },
    "credential_env_var": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[A-Z][A-Z0-9_]*$"
    }
  }
}
