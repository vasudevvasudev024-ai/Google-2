{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus-apex.contracts/v1.0/agent-result.schema.json",
  "title": "AgentResult",
  "description": "NEXUS APEX Core Contract System (NACS) v1.0 AgentResult contract capturing agent task outcome, structured output, artifact references, usage accounting, and structured errors.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "task_id",
    "workspace_id",
    "status",
    "summary",
    "structured_output",
    "artifact_ids",
    "usage",
    "errors"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "1.0"
    },
    "task_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "workspace_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "status": {
      "type": "string",
      "enum": ["succeeded", "failed", "blocked", "needs_correction", "cancelled"]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "structured_output": {
      "type": "object"
    },
    "artifact_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3,
        "pattern": "^[a-zA-Z0-9_-]+$"
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tokens_input", "tokens_output", "compute_seconds", "cost_amount", "currency"],
      "properties": {
        "tokens_input": { "type": "integer", "minimum": 0 },
        "tokens_output": { "type": "integer", "minimum": 0 },
        "compute_seconds": { "type": "number", "minimum": 0 },
        "cost_amount": { "type": "number", "minimum": 0 },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message", "retryable"],
        "properties": {
          "code": { "type": "string", "minLength": 2, "pattern": "^[A-Z0-9_]+$" },
          "message": { "type": "string", "minLength": 1 },
          "retryable": { "type": "boolean" },
          "details": { "type": "object" }
        }
      }
    }
  }
}
