{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus-apex.contracts/v1.0/task-envelope.schema.json",
  "title": "TaskEnvelope",
  "description": "NEXUS APEX Core Contract System (NACS) v1.0 TaskEnvelope contract governing agent identity, capability, inputs, dependencies, idempotency, retries, risk level, and timestamps.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "task_id",
    "workflow_id",
    "workspace_id",
    "project_id",
    "agent_id",
    "capability",
    "input",
    "expected_output",
    "dependencies",
    "idempotency_key",
    "priority",
    "attempt",
    "max_attempts",
    "risk_level",
    "timestamps"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "1.0"
    },
    "task_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "workflow_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "workspace_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "project_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "agent_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "capability": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z]+\\.[a-z0-9_]+$"
    },
    "input": {
      "type": "object"
    },
    "expected_output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_type", "format"],
      "properties": {
        "artifact_type": { "type": "string", "minLength": 2 },
        "format": { "type": "string", "minLength": 2 },
        "schema_ref": { "type": "string" }
      }
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3,
        "pattern": "^[a-zA-Z0-9_-]+$"
      }
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9_.:-]+$"
    },
    "priority": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "max_attempts": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "risk_level": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    },
    "action_type": {
      "type": "string",
      "enum": [
        "internal_compute",
        "public_publishing",
        "external_message",
        "purchase",
        "payment",
        "destructive_operation",
        "sensitive_account_modification"
      ]
    },
    "timestamps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["created_at", "updated_at"],
      "properties": {
        "created_at": { "type": "string", "format": "date-time" },
        "scheduled_at": { "type": "string", "format": "date-time" },
        "started_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" },
        "deadline_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
